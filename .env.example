# Copy to .env.local for `vercel dev`, and set the same in
# Vercel → Settings → Environment Variables for production.

# ---- Storage (recommended) -------------------------------------
# Run supabase/schema.sql once first. See docs/WAITLIST-STORAGE.md.
#
# The service_role key bypasses row-level security. That is the whole
# point of it, and the whole reason it must never reach a browser:
# never put it in public/, never in config.js, never in a commit.
# If it ever leaks, rotate it in Supabase → Settings → API immediately.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Notification (optional, on top of storage) ----------------
# With Supabase configured these are a ping, not the store — a lead
# already in the database is not reported as failed if these are down.
# With NO Supabase, whichever of these is set becomes the store.

# Any endpoint that accepts a JSON POST — Google Apps Script /exec,
# Zapier, n8n, your own API.
WAITLIST_WEBHOOK_URL=

# Or a Web3Forms access key; submissions arrive by email.
WEB3FORMS_KEY=

# With none of the above, /api/waitlist runs in preview mode:
# it validates and logs, but stores nothing.
