# Copy to .env.local for `vercel dev`, and set the same in
# Vercel → Settings → Environment Variables for production.

# ---- Where signups go ------------------------------------------
# Into the One Interiors product database, so ops sees the waitlist
# beside everything else at /ops/waitlist. See docs/WAITLIST-STORAGE.md.
#
# This is a bearer token, NOT a database credential, and that is the
# whole design: a Supabase service_role key would let this marketing
# page read every user, brief and quote in the product. A token scoped
# to one route lets it add a name to one table.
#
# WAITLIST_INGEST_TOKEN must be IDENTICAL in both projects.
# NOT oneinteriors.in — that host is THIS page. Pointing at it would make
# the function POST to itself. The product app answers on the subdomains.
ONE_INTERIORS_INGEST_URL=https://ops.oneinteriors.in/api/waitlist
WAITLIST_INGEST_TOKEN=

# ---- Notification (optional, on top of storage) ----------------
# With the ingest URL set these are a ping, not the store — a lead
# already in Postgres is not reported as failed if these are down.
# With NO ingest URL, whichever of these is set becomes the store.

# Any endpoint that accepts a JSON POST — Zapier, n8n, your own API.
WAITLIST_WEBHOOK_URL=

# Or a Web3Forms access key; submissions arrive by email.
WEB3FORMS_KEY=

# With none of the above, /api/waitlist runs in preview mode:
# it validates and logs, but stores nothing.
