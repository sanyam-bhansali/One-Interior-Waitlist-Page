# Copy to .env.local for `vercel dev`, and set the same in
# Vercel -> Settings -> Environment Variables for production.
# Set ONE of these. With neither, /api/waitlist runs in preview
# mode: it validates and logs, but stores nothing.

# Any endpoint that accepts a JSON POST — Google Apps Script /exec,
# Zapier, n8n, your own API.
WAITLIST_WEBHOOK_URL=

# Or a Web3Forms access key; submissions arrive by email.
WEB3FORMS_KEY=
